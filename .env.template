# GCP & BigQuery Credentials
GCP_PROJECT_ID=dialer-dw-prod
GCP_KEY_PATH=./keys/gcp_key.json
BQ_LOCATION=US

# ReadyMode Ingestion (HTTP / Session Auth)
READYMODE_URL=https://your-domain.readymode.com
READYMODE_USER=your_readymode_username
READYMODE_PASSWORD=your_readymode_password
READYMODE_REPORT_ID_1=12345
READYMODE_REPORT_ID_2=67890

# Airflow Core Config
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./airflow
AIRFLOW__CORE__LOAD_EXAMPLES=false
# Encrypts Airflow Connection/Variable secrets in the metadata DB. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# dbt Environment Config
# DBT_PROFILES_DIR / DBT_PROJECT_DIR are set in docker-compose.yml (container paths)
DBT_DATASET=dialer_dw_dev
